#!/bin/sh
#
# @name TVC Coaxial VTVL (POSTECH PSI UGRP)
# @type Rocket
# @class Rocket
#
# PX4 SITL airframe for the coaxial TVC vehicle: two counter-rotating rotors
# on a 2-axis gimbal.
#
# READ THIS BEFORE USING IT -- PX4 has no native thrust-vectored-rocket
# airframe. Its control allocator assumes control torque comes from rotor
# thrust DIFFERENCES across a geometry of fixed-direction rotors. Here, pitch
# and roll torque come from tilting a single thrust vector, and the two coax
# rotors are nearly co-located, so their thrust difference gives essentially
# only yaw. The stock multirotor allocation therefore cannot fly this vehicle
# no matter how the geometry params are set.
#
# There are two real options; this file sets up (A):
#
#   (A) OFFBOARD DIRECT ACTUATOR CONTROL (what this file configures)
#       Run the attitude controller in ROS2 (tvc_control/controller_node.py
#       already implements the cascaded PID) and send actuator setpoints to
#       PX4 over uXRCE-DDS. PX4 handles state estimation, arming, failsafes,
#       and logging; it does NOT do attitude control. No firmware changes,
#       and the controller stays in Python where it can be tuned against the
#       same physics.py the GUI and Gazebo sim use.
#
#   (B) CUSTOM ActuatorEffectiveness MODULE (firmware change)
#       Add a src/modules/control_allocator/ActuatorEffectiveness/
#       ActuatorEffectivenessTVC.{cpp,hpp} expressing "torque = L x R(delta)*T"
#       and register a new CA_AIRFRAME value. This is a genuine firmware
#       change but a self-contained one -- a new file plus an enum entry,
#       not a rewrite -- so it rebases across PX4 releases far more cleanly
#       than a scattered fork. Worth doing only once (A) has flown and the
#       control law is settled.
#
# Start with (A). Move to (B) only if you need PX4's own attitude loop (for
# example to use its position/mission modes without a companion computer).

. ${R}etc/init.d/rc.mc_defaults

# --- geometry: 2 rotors, 2 servos ----------------------------------------
# Rotors are declared so PX4 knows the actuator count and can drive them in
# offboard actuator mode. The position/axis values are physically honest but
# are NOT used to synthesize attitude torque in mode (A).
param set-default CA_AIRFRAME 0

param set-default CA_ROTOR_COUNT 2
# Rotor A: CCW (+z spin), at the gimbal, on the thrust axis
param set-default CA_ROTOR0_PX 0.0
param set-default CA_ROTOR0_PY 0.0
param set-default CA_ROTOR0_PZ 0.0
param set-default CA_ROTOR0_KM 0.016
# Rotor B: CW -- opposite spin is the entire yaw authority on this airframe
param set-default CA_ROTOR1_PX 0.0
param set-default CA_ROTOR1_PY 0.0
param set-default CA_ROTOR1_PZ -0.03
param set-default CA_ROTOR1_KM -0.016

# Two gimbal servos (pitch-plane, roll-plane)
param set-default CA_SV_CS_COUNT 2

# --- outputs ---------------------------------------------------------------
param set-default SIM_GZ_EN 1

param set-default SIM_GZ_EC_FUNC1 101      # rotor A
param set-default SIM_GZ_EC_FUNC2 102      # rotor B
param set-default SIM_GZ_EC_MIN1 0
param set-default SIM_GZ_EC_MIN2 0
param set-default SIM_GZ_EC_MAX1 1100
param set-default SIM_GZ_EC_MAX2 1100

param set-default SIM_GZ_SV_FUNC1 201      # gimbal pitch
param set-default SIM_GZ_SV_FUNC2 202      # gimbal roll
# +/- 15 deg mechanical limit, matching the SDF joint limits and
# VehicleParams.gimbal_max_deg. Exceeding this in sim would silently model a
# gimbal the hardware does not have.
param set-default SIM_GZ_SV_MIN1 -262
param set-default SIM_GZ_SV_MAX1 262
param set-default SIM_GZ_SV_MIN2 -262
param set-default SIM_GZ_SV_MAX2 262

# --- vehicle limits --------------------------------------------------------
# Measured T/W is only ~1.13 at the highest bench point (14.68 N thrust vs
# 13.0 N weight), so hover sits near full throttle and there is very little
# margin for aggressive attitude commands. Keep tilt limits conservative.
param set-default MPC_TILTMAX_AIR 20
param set-default MPC_THR_HOVER 0.80
param set-default MPC_MANTHR_MIN 0.10

# 3S pack: 3.3 V/cell floor, same limit the bench runner enforces.
param set-default BAT1_N_CELLS 3
param set-default BAT_CRIT_THR 0.10
param set-default BAT_LOW_THR 0.20

# --- offboard / companion --------------------------------------------------
# Allow the ROS2 side to command actuators directly (mode A above).
param set-default COM_RC_IN_MODE 4
param set-default COM_OBL_RC_ACT 0

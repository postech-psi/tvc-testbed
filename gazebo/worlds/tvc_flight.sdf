<?xml version="1.0"?>
<sdf version="1.9">
  <world name="tvc_flight">
    <physics name="1ms" type="ignored">
      <!-- 1 ms step: the gimbal servo loop runs at 100 Hz and the rotors have
           a 12.5 ms time constant, so a coarser step visibly changes the
           attitude response rather than just the render smoothness. -->
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!--
      Fixed chase camera for headless video capture. A static model with a
      camera sensor is the only way to get frames without a GUI, which the
      dev container has no display for. Aimed at the 2 m hover point.
    -->
    <model name="camera_rig">
      <static>true</static>
      <!-- 3.0 m from the 2 m hover point: the vehicle fills ~40% of frame
           height. Farther out and it is a speck; closer and it leaves
           frame during the recovery transient. -->
      <pose>2.2 -2.0 2.15 0 0.0504 2.4038</pose>
      <link name="link">
        <sensor name="chase_cam" type="camera">
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <topic>/chase_cam/image</topic>
          <camera>
            <horizontal_fov>0.9</horizontal_fov>
            <image><width>960</width><height>640</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>120</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <include>
      <uri>model://tvc_vehicle</uri>
      <!--
        Airborne at hover altitude, and deliberately spawned TILTED: roll
        +10 deg, pitch -7 deg. A perfectly upright spawn is a useless test:
        the vehicle is already in equilibrium, the controller has nothing to
        reject, and the gimbal sits at exactly 0 for the whole run. Starting
        it off-attitude is what actually exercises the thrust vectoring.

        Taking off from the legs is a separate problem (ground contact during
        spin-up); this world isolates hover. Use worlds/tvc.sdf for that.
      -->
      <pose>0 0 2.0 0.1745 -0.1222 0</pose>
    </include>
  </world>
</sdf>

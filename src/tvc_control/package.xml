<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tvc_control</name>
  <version>0.0.1</version>
  <description>TVC VTVL flight code, plant models and ROS 2 nodes (POSTECH UGRP coaxial thrust-vectored demonstrator)</description>
  <maintainer email="kyber06@icloud.com">devkyber</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tvc_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>python3-scipy</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-tk</exec_depend>

  <!-- Launch files and installed package discovery. -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Gazebo software-in-the-loop: gazebo_bridge_node + gazebo.launch.py -->
  <depend>actuator_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <exec_depend>ros_gz_bridge</exec_depend>


  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
